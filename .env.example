# Server Port
PORT=3005

# Optional Telegram Bot Token (used if telegram_config.json has no botToken)
TELEGRAM_BOT_TOKEN=

# Optional extra CORS origins (comma-separated) alongside *.pages.dev and GitHub Pages
CORS_ORIGINS=

# Optional Static Demo URL used by `npm run tunnel:quick` to print combined ?backend= link
STATIC_DEMO_URL=https://dtc245200452-hub.github.io/traffic_server/

# Optional Cloudflare API v4 integration (`npm run cf:verify`)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=traffic-server-demo
