# Server Port (host port when using Docker Compose; container listens on 3005)
PORT=3005

# Optional Telegram Bot Token (used if telegram_config.json has no botToken)
TELEGRAM_BOT_TOKEN=

# Optional extra CORS origins (comma-separated, e.g. https://demo.yourdomain.com)
# Note: *.pages.dev, *.trycloudflare.com, and official GitHub Pages origins are already allowed.
CORS_ORIGINS=

# SSRF Guard: keep false in production to block loopback/private network target URLs.
# Set to true only when testing against local or private-network target servers.
ALLOW_PRIVATE_TARGET_URLS=false

# Optional Static Demo URL used by `tunnel:quick` and `named` to print combined ?backend= link
STATIC_DEMO_URL=https://dtc245200452-hub.github.io/traffic_server/

# Optional Cloudflare Named Tunnel (Zero Trust -> Networks -> Tunnels)
# Used by `node scripts/cf-tunnel.js named` and `docker compose --profile tunnel up -d`
CLOUDFLARE_TUNNEL_TOKEN=
# Optional public hostname of your Named Tunnel (e.g. https://api.yourdomain.com)
CLOUDFLARE_TUNNEL_URL=

# Optional Cloudflare API v4 integration (`npm run cf:verify` & GitHub Actions Pages deploy)
# Scoped API Token permissions: Account Settings: Read (or set CLOUDFLARE_ACCOUNT_ID),
# Cloudflare Pages: Edit, and Cloudflare Tunnel: Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=traffic-server-demo
